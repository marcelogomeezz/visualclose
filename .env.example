# VisualClose — server-side provider configuration (never exposed to the client)
# Milestone 1 runs entirely on mock providers. Leave these unset for local work.

# AI provider for analyzeScene / analyzeProduct / createRenderBrief / validateResult: "mock" | "openai"
VISUALCLOSE_AI_PROVIDER=mock
# OPENAI_API_KEY=

# Generation provider for generateReality / generateArchviz / generateMotion: "mock" | "higgsfield"
VISUALCLOSE_GENERATION_PROVIDER=mock
# HIGGSFIELD_API_KEY=
